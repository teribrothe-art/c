{
  "name": "hair-diary-app",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "dependencies": {
    "@expo/ui": "~56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.106.1",
    "@tosspayments/payment-sdk": "^1.9.2",
    "axios": "^1.16.1",
    "expo": "~56.0.4",
    "expo-av": "^16.0.8",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.9",
    "expo-image-manipulator": "~56.0.14",
    "expo-image-picker": "~56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.6",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.16",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "prestart:wifi": "node scripts/invalidate-connect-manifest.mjs",
    "start:wifi": "CI=false expo start --lan --clear",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "prestart:phone": "node scripts/invalidate-connect-manifest.mjs",
    "start:phone": "CI=false expo start --tunnel --clear",
    "tunnel:policy": "node scripts/start-ngrok-policy.mjs 8081",
    "tunnel:policy:80": "node scripts/start-ngrok-policy.mjs 80",
    "share": "node scripts/share-expo-go.mjs",
    "phone:wifi": "node -e \"console.log('ngrok 없음 (같은 Wi-Fi)\\n\\n터미널1: npm run start:wifi\\n터미널2: npm run share\\n\\nAndroid USB: npm run start && npm run android:usb\\nWindows: scripts\\\\start-wifi-pc.cmd')\"",
    "phone:standalone": "node -e \"console.log('Metro 없이 (설치형 앱)\\n\\n1회 빌드: npm run build:preview:android\\nAPK 설치 후 앱 아이콘으로 실행\\n\\n코드만 갱신: npm run update:preview\\n\\n웹만: npm run export:web → dist 폴더를 정적 호스팅')\"",
    "phone:pc": "node -e \"console.log('터널(ngrok) 필요 시:\\n내장: npm run start:phone → npm run share\\nv3 정책: npm run start:wifi → npm run tunnel:policy → npm run share\\nCLI: ngrok http 8081 --traffic-policy-file policy.yaml\\n\\nngrok 없음: npm run phone:wifi\\nWindows: scripts\\\\start-wifi-pc.cmd')\"",
    "android:usb": "node scripts/setup-android-usb.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "web:clear": "CI=1 expo start --web --port 8081 --clear",
    "check:dev": "node scripts/check-dev-server.mjs",
    "check:phone": "node scripts/check-phone-bundle.mjs",
    "check:app": "node scripts/check-app-connection.mjs",
    "qr": "node scripts/generate-expo-qr.mjs",
    "qr:html": "node scripts/generate-expo-qr.mjs --html",
    "lint": "expo lint",
    "beta:smoke": "node scripts/beta-smoke-demo.mjs",
    "designer:link-mock": "node scripts/designer-customer-link-mock.mjs",
    "verify:login": "node scripts/verify-login-screen.mjs",
    "verify:designer-home": "node scripts/verify-designer-home-feed.mjs",
    "verify:diary": "node scripts/verify-diary-home.mjs",
    "verify:org-simulation": "node scripts/verify-org-virtual-simulation.mjs",
    "verify:nationwide-catalog": "node --experimental-strip-types scripts/verify-nationwide-org-catalog.mjs",
    "verify:nationwide-login": "node --experimental-strip-types scripts/verify-nationwide-designer-login.mjs",
    "verify:staged-login": "node --experimental-strip-types scripts/verify-staged-login.mjs",
    "beta:e2e": "node scripts/beta-e2e-ten-users.mjs",
    "export:web": "expo export --platform web",
    "build:preview:android": "eas build --profile preview --platform android --non-interactive",
    "build:preview:ios": "eas build --profile preview --platform ios --non-interactive",
    "update:preview": "eas update --branch preview --message \"베타 v1.0.7 · 원 단위 · 주간/월별 매출\""
  },
  "private": true
}
